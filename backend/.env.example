GROQ_API_KEY=<your_groq_API_key>
TAVILY_API_KEY=<your_tavily_API_key>
AVIATIONSTACK_API_KEY=<your_AviationStack_API_key>

# psycopg DSN. Use the Postgres *external* URL in production.
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=<your_postgres_DB_url>

FRONTEND_URL=http://localhost:3000
# Supabase Auth JWT signing secret from Dashboard > Project Settings > API > JWT Keys.
# Do not use SUPABASE_SECRET_KEY/service-role key here.
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-signing-secret
SUPABASE_URL=https://your-project.supabase.co
ENVIRONMENT=development
SUPABASE_JWT_SECRET=<your_supabase_jwt_secret>

LLM_MODEL=openai/gpt-oss-120b
DEFAULT_ORIGIN_IATA=HYD

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your_LangSmith_API_key>
LANGSMITH_PROJECT=VoyageMesh
